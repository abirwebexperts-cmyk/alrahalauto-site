# Al Rahal Auto Maintenance — Apache/LiteSpeed config for Namecheap shared hosting
# This is a fully static site: no PHP, no Node.js, no database.
ErrorDocument 403 /404.html
ErrorDocument 404 /404.html
# Redirects for renamed pages
Redirect 301 /blog/range-rover-service-cost-dubai/ /blog/range-rover-service-cost-sharjah/
RedirectMatch 301 ^/models/discovery-sport/?$ /models/
RedirectMatch 301 ^/services/([^/]+)/discovery-sport/?$ /services/$1/
RedirectMatch 301 ^/locations/([^/]+)/[^/]*discovery-sport[^/]*/?$ /locations/$1/
Options -Indexes
DirectoryIndex index.html

<IfModule mod_rewrite.c>
RewriteEngine On
# --- Canonical URL ----------------------------------------------------------
# Force HTTPS + www
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} !^www\. [NC]
RewriteCond %{HTTP_HOST} ^(?:www\.)?(.+)$ [NC]
RewriteRule ^ https://www.%1%{REQUEST_URI} [R=301,L]
# Add trailing slash to directory URLs
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^(.*[^/])$ /$1/ [R=301,L]
# --- Security ---------------------------------------------------------------
# Refuse HTTP methods a static site never needs
RewriteCond %{REQUEST_METHOD} ^(TRACE|TRACK|DEBUG|CONNECT)$ [NC]
RewriteRule ^ - [F,L]
# No server-side code here: refuse every script request so server-side
# vulnerabilities (e.g. PHP2Shell, CVE-2026-109618/109619) can't be reached via this site
RewriteRule \.(php[0-9]?|phtml|phar|inc|pl|py|cgi|sh|asp|aspx|jsp)$ - [F,NC,L]
# Hide dotfiles (.git, .env, .gitkeep ...) but keep /.well-known/ for SSL renewal
RewriteRule (^|/)\.(?!well-known(/|$)) - [F,L]
# Hide backups, logs, archives and config files
RewriteRule \.(bak|old|orig|save|swp|sql|log|ini|env|yml|yaml|lock|conf|zip|tar|gz|tgz|7z|rar)$ - [F,NC,L]
# Common attack paths (this is not WordPress / phpMyAdmin)
RewriteRule ^(wp-admin|wp-includes|wp-content|phpmyadmin|pma|vendor|node_modules)(/|$) - [F,NC,L]
</IfModule>

<IfModule mod_deflate.c>
AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/json image/svg+xml text/xml application/xml
</IfModule>

<IfModule mod_expires.c>
ExpiresActive On
ExpiresByType text/css "access plus 1 month"
ExpiresByType application/javascript "access plus 1 month"
ExpiresByType image/jpeg "access plus 1 year"
ExpiresByType image/png "access plus 1 year"
ExpiresByType image/webp "access plus 1 year"
ExpiresByType image/svg+xml "access plus 1 year"
ExpiresByType text/html "access plus 0 seconds"
</IfModule>

<IfModule mod_headers.c>
<FilesMatch "\.(html)$">
Header set Cache-Control "no-cache, must-revalidate"
</FilesMatch>
Header always set X-Content-Type-Options "nosniff"
Header always set X-Frame-Options "SAMEORIGIN"
Header always set Referrer-Policy "strict-origin-when-cross-origin"
Header always set Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=(), usb=()"
Header always set Strict-Transport-Security "max-age=31536000"
Header always set Content-Security-Policy "upgrade-insecure-requests; frame-ancestors 'self'; base-uri 'self'; object-src 'none'; form-action 'self'"
Header always set Cross-Origin-Opener-Policy "same-origin-allow-popups"
Header always unset X-Powered-By
Header unset X-Powered-By
</IfModule>
